{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Бэкенд расчёта энергии межпланетных перелётов.\nБез авторизации доступно только чтение (список и лента услуг). Методы создателя требуют JWT:\nполучите токен в POST /api/auth/login, нажмите Authorize и вставьте «Bearer \u003caccess_token\u003e».",
        "title": "Interplanet travel energy API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/auth/login": {
            "post": {
                "description": "Проверяет логин и пароль и выдаёт JWT (HS256). Токен передаётся в заголовке «Authorization: Bearer \u003cтокен\u003e».\nВ Swagger: нажмите Authorize и вставьте «Bearer \u003caccess_token\u003e».",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Аутентификация",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.LoginResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректное тело запроса",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Неверный логин или пароль",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Добавляет текущий токен в blacklist (Redis) до конца срока его действия: после этого любой запрос с этим токеном получает 401.",
                "tags": [
                    "Пользователи"
                ],
                "summary": "Деавторизация",
                "responses": {
                    "200": {
                        "description": "Токен отозван, тела ответа нет"
                    },
                    "401": {
                        "description": "Нет токена, токен просрочен или уже отозван",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/planet-pairs": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Возвращает только опубликованные услуги (черновики и удалённые не передаются), с фильтром по расстоянию.\nДоступен без авторизации и работает одинаково с любым токеном. Если передан действующий токен, в каждом элементе\nполе is_mine = 1 для услуг, созданных этим пользователем; для гостя is_mine всегда 0.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги: чтение"
                ],
                "summary": "Список опубликованных услуг",
                "parameters": [
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Минимальное расстояние (включительно)",
                        "name": "range_min",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "Максимальное расстояние (включительно)",
                        "name": "range_max",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.PlanetPairResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Некорректный фильтр",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "multipart/form-data: задаются только name, photo и video. Остальные поля заполняются при публикации (PUT).\nФайлы сохраняются в MinIO под сгенерированными латинскими именами, имена записываются в БД.\nСоздатель услуги заполняется автоматически из токена; id, статус и даты клиентом не задаются.\nУ пользователя может быть не более одного черновика.",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги: создатель"
                ],
                "summary": "Создать услугу (черновик)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Изображение (jpg, png, gif, webp; до 5 МБ)",
                        "name": "photo",
                        "in": "formData"
                    },
                    {
                        "type": "file",
                        "description": "Короткое видео (mp4, webm; до 50 МБ)",
                        "name": "video",
                        "in": "formData"
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.PlanetPairResponse"
                        }
                    },
                    "400": {
                        "description": "Нет name или недопустимый файл",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Нет токена, токен просрочен или отозван",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Черновик уже существует",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/planet-pairs/draft": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Возвращает черновик пользователя из токена (не более одного), id не указывается. Только для авторизованных.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги: создатель"
                ],
                "summary": "Черновик текущего пользователя",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.PlanetPairResponse"
                        }
                    },
                    "401": {
                        "description": "Нет токена, токен просрочен или отозван",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Черновика нет",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/planet-pairs/feed": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Без параметров возвращает массив всех опубликованных услуг по возрастанию id.\nС next=true возвращает ОДНУ услугу (объект, а не массив), следующую за услугой с id; после последней возвращается первая,\nбез id возвращается первая. Доступна без авторизации. В элементах есть liked_by_me: 1, если текущий пользователь\n(по токену) лайкнул услугу, для гостя всегда 0.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги: чтение"
                ],
                "summary": "Лента опубликованных услуг",
                "parameters": [
                    {
                        "type": "boolean",
                        "description": "true - вернуть одну услугу, следующую за id",
                        "name": "next",
                        "in": "query"
                    },
                    {
                        "minimum": 0,
                        "type": "integer",
                        "description": "id текущей услуги (используется вместе с next=true)",
                        "name": "id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Лента; при next=true в ответе один объект PlanetPairResponse",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handler.PlanetPairResponse"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Нет опубликованных услуг",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/planet-pairs/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Мягкое удаление (статус deleted, запись остаётся в БД). Только услуги текущего пользователя.",
                "tags": [
                    "Услуги: создатель"
                ],
                "summary": "Удалить услугу",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Удалено, тела ответа нет"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Нет токена, токен просрочен или отозван",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Услуга принадлежит другому пользователю",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Услуга не найдена",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/planet-pairs/{id}/like": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "like = 1 ставит лайк от текущего пользователя, like = 0 отменяет. Повторный лайк не создаёт дубликат.\nЛайкать можно только опубликованные услуги.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги: создатель"
                ],
                "summary": "Поставить или снять лайк",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "like: 1 или 0",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.LikeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.LikeResponse"
                        }
                    },
                    "400": {
                        "description": "like не 0/1 или некорректный id",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Нет токена, токен просрочен или отозван",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Опубликованной услуги нет",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/planet-pairs/{id}/publish": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Заполняет остальные поля (description, distance, period) и меняет статус draft -\u003e published.\nТолько создатель услуги; вернуть услугу в черновик нельзя.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Услуги: создатель"
                ],
                "summary": "Опубликовать услугу",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "ID услуги",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Поля услуги",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.PublishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handler.PlanetPairResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректный id или поля",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Нет токена, токен просрочен или отозван",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "403": {
                        "description": "Услуга принадлежит другому пользователю",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Услуга не найдена",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Услуга уже опубликована",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/users": {
            "post": {
                "description": "Создаёт пользователя. Пароль сохраняется только в виде bcrypt-хеша. Токен при регистрации не выдаётся: после неё нужно вызвать /api/auth/login.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Пользователи"
                ],
                "summary": "Регистрация",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/handler.RegisterRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/handler.UserResponse"
                        }
                    },
                    "400": {
                        "description": "Некорректные данные",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Логин уже занят",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/handler.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handler.ErrorResponse": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "описание ошибки"
                },
                "status": {
                    "type": "string",
                    "example": "error"
                }
            }
        },
        "handler.LikeRequest": {
            "type": "object",
            "required": [
                "like"
            ],
            "properties": {
                "like": {
                    "description": "Указатель, чтобы значение 0 не считалось \"поле не передано\".",
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ],
                    "example": 1
                }
            }
        },
        "handler.LikeResponse": {
            "type": "object",
            "properties": {
                "like_count": {
                    "type": "integer",
                    "example": 4
                }
            }
        },
        "handler.LoginRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "type": "string",
                    "example": "secret123"
                },
                "username": {
                    "type": "string",
                    "example": "alice"
                }
            }
        },
        "handler.LoginResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                },
                "expires_in": {
                    "description": "секунд",
                    "type": "integer",
                    "example": 3600
                },
                "token_type": {
                    "type": "string",
                    "example": "Bearer"
                }
            }
        },
        "handler.PlanetPairResponse": {
            "type": "object",
            "properties": {
                "creation_time": {
                    "type": "string"
                },
                "creator_id": {
                    "type": "integer",
                    "example": 1
                },
                "description": {
                    "type": "string",
                    "example": "Окно запуска"
                },
                "distance": {
                    "type": "integer",
                    "example": 225000000
                },
                "forming_time": {
                    "type": "string"
                },
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "is_mine": {
                    "description": "только в списке",
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ],
                    "example": 1
                },
                "like_count": {
                    "type": "integer",
                    "example": 3
                },
                "liked_by_me": {
                    "description": "только в ленте",
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ],
                    "example": 0
                },
                "name": {
                    "type": "string",
                    "example": "Земля - Марс"
                },
                "period": {
                    "type": "integer",
                    "example": 780
                },
                "photo_url": {
                    "type": "string",
                    "example": "http://localhost:9000/media/photo-3f9a.jpg?X-Amz-..."
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "draft",
                        "published"
                    ],
                    "example": "published"
                },
                "video_url": {
                    "type": "string",
                    "example": "http://localhost:9000/media/video-7c1b.mp4?X-Amz-..."
                }
            }
        },
        "handler.PublishRequest": {
            "type": "object",
            "required": [
                "description",
                "distance",
                "period"
            ],
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Окно запуска Земля - Марс"
                },
                "distance": {
                    "type": "integer",
                    "example": 225000000
                },
                "period": {
                    "type": "integer",
                    "example": 780
                }
            }
        },
        "handler.RegisterRequest": {
            "type": "object",
            "required": [
                "password",
                "username"
            ],
            "properties": {
                "password": {
                    "description": "72 байта - предел bcrypt",
                    "type": "string",
                    "maxLength": 72,
                    "example": "secret123"
                },
                "username": {
                    "type": "string",
                    "maxLength": 50,
                    "example": "alice"
                }
            }
        },
        "handler.UserResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 1
                },
                "username": {
                    "type": "string",
                    "example": "alice"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "JWT в формате: Bearer \u003caccess_token\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}